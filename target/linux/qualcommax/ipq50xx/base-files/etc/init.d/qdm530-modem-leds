#!/bin/sh /etc/rc.common
# Drive the QDM530 mobile(signal)/status front LEDs from wwand modem state.

START=99
USE_PROCD=1

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "unbranded,qdm530" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/qdm530-modem-leds
	procd_set_param respawn
	procd_close_instance
}
