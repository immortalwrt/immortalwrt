From 0d05596ba18a44aca87082b75989bb4114f896d8 Mon Sep 17 00:00:00 2001
From: Murat Sezgin <msezgin@codeaurora.org>
Date: Tue, 18 Apr 2017 15:48:01 -0700
Subject: [PATCH 353/500] net: conntrack events, support multiple registrant

Change-Id: Iebfb254590fb594f5baf232f849d1b7ae45ef757
Signed-off-by: Zhi Chen <zhichen@codeaurora.org>
Signed-off-by: Murat Sezgin <msezgin@codeaurora.org>
---
 include/net/netfilter/nf_conntrack_ecache.h | 45 +++++++++++++-
 include/net/netns/conntrack.h               |  3 +
 net/netfilter/Kconfig                       |  8 +++
 net/netfilter/nf_conntrack_core.c           |  3 +
 net/netfilter/nf_conntrack_ecache.c         | 67 +++++++++++++++++++++
 net/netfilter/nf_conntrack_netlink.c        | 25 +++++++-
 6 files changed, 148 insertions(+), 3 deletions(-)

--- a/include/net/netfilter/nf_conntrack_ecache.h
+++ b/include/net/netfilter/nf_conntrack_ecache.h
@@ -56,6 +56,13 @@ struct nf_ct_event {
 	struct nf_conn *ct;
 	u32 portid;
 	int report;
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	/*
+	 * Initialized to zero before dispatch. Preserve the first error and
+	 * return NOTIFY_DONE so every subscriber runs, including on retries.
+	 */
+	int ret;
+#endif
 };
 
 struct nf_exp_event {
@@ -69,9 +76,17 @@ struct nf_ct_event_notifier {
 	int (*exp_event)(unsigned int events, const struct nf_exp_event *item);
 };
 
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+int nf_conntrack_register_notifier(struct net *net, struct notifier_block *nb);
+int nf_conntrack_unregister_notifier(struct net *net, struct notifier_block *nb);
+void nf_ct_expect_register_notifier(struct net *net,
+				    const struct nf_ct_event_notifier *nb);
+void nf_ct_expect_unregister_notifier(struct net *net);
+#else
 void nf_conntrack_register_notifier(struct net *net,
 				   const struct nf_ct_event_notifier *nb);
 void nf_conntrack_unregister_notifier(struct net *net);
+#endif
 
 void nf_ct_deliver_cached_events(struct nf_conn *ct);
 int nf_conntrack_eventmask_report(unsigned int eventmask, struct nf_conn *ct,
@@ -105,7 +120,11 @@ nf_conntrack_event_cache(enum ip_conntra
 	struct net *net = nf_ct_net(ct);
 	struct nf_conntrack_ecache *e;
 
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	if (!rcu_access_pointer(net->ct.nf_conntrack_chain.head))
+#else
 	if (!rcu_access_pointer(net->ct.nf_conntrack_event_cb))
+#endif
 		return;
 
 	e = nf_ct_ecache_find(ct);
--- a/include/net/netns/conntrack.h
+++ b/include/net/netns/conntrack.h
@@ -2,6 +2,7 @@
 #ifndef __NETNS_CONNTRACK_H
 #define __NETNS_CONNTRACK_H
 
+#include <linux/notifier.h>
 #include <linux/list.h>
 #include <linux/list_nulls.h>
 #include <linux/atomic.h>
@@ -91,6 +92,9 @@ struct netns_ct {
 	u8			sysctl_checksum;
 
 	struct ip_conntrack_stat __percpu *stat;
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	struct atomic_notifier_head nf_conntrack_chain;
+#endif
 	struct nf_ct_event_notifier __rcu *nf_conntrack_event_cb;
 	struct nf_ip_net	nf_ct_proto;
 #if defined(CONFIG_NF_CONNTRACK_LABELS)
--- a/net/netfilter/Kconfig
+++ b/net/netfilter/Kconfig
@@ -164,6 +164,14 @@ config NF_CONNTRACK_EVENTS
 
 	  If unsure, say `N'.
 
+config NF_CONNTRACK_CHAIN_EVENTS
+	bool "Register multiple callbacks to ct events"
+	depends on NF_CONNTRACK_EVENTS
+	help
+	  Support multiple registrations.
+
+	  If unsure, say `N'.
+
 config NF_CONNTRACK_TIMEOUT
 	bool  'Connection tracking timeout'
 	depends on NETFILTER_ADVANCED
--- a/net/netfilter/nf_conntrack_core.c
+++ b/net/netfilter/nf_conntrack_core.c
@@ -2722,6 +2722,10 @@ int nf_conntrack_init_net(struct net *ne
 	nf_conntrack_ecache_pernet_init(net);
 	nf_conntrack_proto_pernet_init(net);
 
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	ATOMIC_INIT_NOTIFIER_HEAD(&net->ct.nf_conntrack_chain);
+#endif
+
 	return 0;
 
 err_expect:
--- a/net/netfilter/nf_conntrack_ecache.c
+++ b/net/netfilter/nf_conntrack_ecache.c
@@ -127,16 +127,24 @@ static void ecache_work(struct work_stru
 static int __nf_conntrack_eventmask_report(struct nf_conntrack_ecache *e,
 					   const u32 events,
 					   const u32 missed,
-					   const struct nf_ct_event *item)
+					   struct nf_ct_event *item)
 {
 	struct net *net = nf_ct_net(item->ct);
+#ifndef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
 	struct nf_ct_event_notifier *notify;
+#endif
 	u32 old, want;
 	int ret;
 
 	if (!((events | missed) & e->ctmask))
 		return 0;
 
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	item->ret = 0;
+	atomic_notifier_call_chain(&net->ct.nf_conntrack_chain,
+				   events | missed, item);
+	ret = item->ret;
+#else
 	rcu_read_lock();
 
 	notify = rcu_dereference(net->ct.nf_conntrack_event_cb);
@@ -147,6 +155,7 @@ static int __nf_conntrack_eventmask_repo
 
 	ret = notify->ct_event(events | missed, item);
 	rcu_read_unlock();
+#endif
 
 	if (likely(ret >= 0 && missed == 0))
 		return 0;
@@ -270,8 +279,27 @@ out_unlock:
 	rcu_read_unlock();
 }
 
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+int nf_conntrack_register_notifier(struct net *net, struct notifier_block *nb)
+{
+	return atomic_notifier_chain_register(&net->ct.nf_conntrack_chain, nb);
+}
+EXPORT_SYMBOL_GPL(nf_conntrack_register_notifier);
+
+int nf_conntrack_unregister_notifier(struct net *net, struct notifier_block *nb)
+{
+	return atomic_notifier_chain_unregister(&net->ct.nf_conntrack_chain, nb);
+}
+EXPORT_SYMBOL_GPL(nf_conntrack_unregister_notifier);
+#endif
+
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+void nf_ct_expect_register_notifier(struct net *net,
+				    const struct nf_ct_event_notifier *new)
+#else
 void nf_conntrack_register_notifier(struct net *net,
 				    const struct nf_ct_event_notifier *new)
+#endif
 {
 	struct nf_ct_event_notifier *notify;
 
@@ -282,16 +310,28 @@ void nf_conntrack_register_notifier(stru
 	rcu_assign_pointer(net->ct.nf_conntrack_event_cb, new);
 	mutex_unlock(&nf_ct_ecache_mutex);
 }
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+EXPORT_SYMBOL_GPL(nf_ct_expect_register_notifier);
+#else
 EXPORT_SYMBOL_GPL(nf_conntrack_register_notifier);
+#endif
 
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+void nf_ct_expect_unregister_notifier(struct net *net)
+#else
 void nf_conntrack_unregister_notifier(struct net *net)
+#endif
 {
 	mutex_lock(&nf_ct_ecache_mutex);
 	RCU_INIT_POINTER(net->ct.nf_conntrack_event_cb, NULL);
 	mutex_unlock(&nf_ct_ecache_mutex);
 	/* synchronize_rcu() is called after netns pre_exit */
 }
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+EXPORT_SYMBOL_GPL(nf_ct_expect_unregister_notifier);
+#else
 EXPORT_SYMBOL_GPL(nf_conntrack_unregister_notifier);
+#endif
 
 void nf_conntrack_ecache_work(struct net *net, enum nf_ct_ecache_state state)
 {
@@ -333,7 +373,11 @@ bool nf_ct_ecache_ext_add(struct nf_conn
 			break;
 		return true;
 	case 2: /* autodetect: no event listener, don't allocate extension. */
-		if (!READ_ONCE(nf_ctnetlink_has_listener))
+		if (!READ_ONCE(nf_ctnetlink_has_listener)
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+		    && !rcu_access_pointer(net->ct.nf_conntrack_chain.head)
+#endif
+		   )
 			return true;
 		fallthrough;
 	case 1:
--- a/net/netfilter/nf_conntrack_netlink.c
+++ b/net/netfilter/nf_conntrack_netlink.c
@@ -33,6 +33,7 @@
 
 #include <linux/netfilter.h>
 #include <net/netlink.h>
+#include <net/netns/generic.h>
 #include <net/sock.h>
 #include <net/netfilter/nf_conntrack.h>
 #include <net/netfilter/nf_conntrack_core.h>
@@ -3761,8 +3762,31 @@ static int ctnetlink_stat_exp_cpu(struct
 }
 
 #ifdef CONFIG_NF_CONNTRACK_EVENTS
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+static unsigned int ctnetlink_net_id;
+
+struct ctnetlink_net {
+	struct notifier_block notifier;
+};
+
+static int ctnetlink_conntrack_event_chain(struct notifier_block *nb,
+					 unsigned long events, void *ptr)
+{
+	struct nf_ct_event *item = ptr;
+	int ret = ctnetlink_conntrack_event(events, item);
+
+	/* A netlink error must not prevent other subscribers from being called. */
+	if (ret < 0 && !item->ret)
+		item->ret = ret;
+
+	return NOTIFY_DONE;
+}
+#endif
+
 static struct nf_ct_event_notifier ctnl_notifier = {
+#ifndef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
 	.ct_event = ctnetlink_conntrack_event,
+#endif
 	.exp_event = ctnetlink_expect_event,
 };
 #endif
@@ -3856,19 +3880,42 @@ MODULE_ALIAS_NFNL_SUBSYS(NFNL_SUBSYS_CTN
 static int __net_init ctnetlink_net_init(struct net *net)
 {
 #ifdef CONFIG_NF_CONNTRACK_EVENTS
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	struct ctnetlink_net *cnet = net_generic(net, ctnetlink_net_id);
+	int ret;
+
+	cnet->notifier.notifier_call = ctnetlink_conntrack_event_chain;
+	ret = nf_conntrack_register_notifier(net, &cnet->notifier);
+	if (ret)
+		return ret;
+
+	nf_ct_expect_register_notifier(net, &ctnl_notifier);
+#else
 	nf_conntrack_register_notifier(net, &ctnl_notifier);
 #endif
+#endif
 	return 0;
 }
 
 static void ctnetlink_net_pre_exit(struct net *net)
 {
 #ifdef CONFIG_NF_CONNTRACK_EVENTS
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	struct ctnetlink_net *cnet = net_generic(net, ctnetlink_net_id);
+
+	nf_ct_expect_unregister_notifier(net);
+	nf_conntrack_unregister_notifier(net, &cnet->notifier);
+#else
 	nf_conntrack_unregister_notifier(net);
 #endif
+#endif
 }
 
 static struct pernet_operations ctnetlink_net_ops = {
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	.id		= &ctnetlink_net_id,
+	.size		= sizeof(struct ctnetlink_net),
+#endif
 	.init		= ctnetlink_net_init,
 	.pre_exit	= ctnetlink_net_pre_exit,
 };
